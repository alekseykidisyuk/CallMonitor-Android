# Build outputs
build/
*.apk
*.keystore
.gradle/
local.properties
.idea/
.DS_Store

# graphify knowledge-graph output (build artifact, not published)
graphify-out/

# internal build/planning notes (not published)
docs/superpowers/
.gstack/

# App signing keystore — the release identity; keep local, back up separately, NEVER commit.
# No trailing slash: in a git worktree this path is a SYMLINK to the main checkout's signing
# directory so release builds can sign, and "/signing/" matches only a real directory — leaving the
# link itself committable by `git add -A`. Matching both shapes is the only version that holds.
/signing

# Native (CMake/NDK) build cache
.cxx/
app/.cxx/
