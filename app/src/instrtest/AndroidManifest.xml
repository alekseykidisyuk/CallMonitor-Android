<?xml version="1.0" encoding="utf-8"?>
<!--
    Manifest overlay for the "instrtest" variant only. Release and debug are untouched.

    The instrtest variant installs SIDE BY SIDE with the real app so instrumented tests can never
    replace a working recorder on the maintainer's daily driver. Two installs cannot share a
    ContentProvider authority, and RecorderBinderProvider's authority is hardcoded in both the
    manifest and RecorderBinderProvider.AUTHORITY — deliberately not parameterised here, because that
    provider is the daemon's binder-delivery channel and is not worth destabilising for a test.

    Removing it from this variant is the safe alternative: the instrumented tests exercise the
    whisper.cpp JNI bridge, which needs no provider, no daemon and no ADB pairing.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <provider
            android:name=".server.RecorderBinderProvider"
            tools:node="remove" />
    </application>

</manifest>
